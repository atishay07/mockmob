# Preserve the exact bytes of the frozen verification contract across Windows
# and other checkouts. Git newline conversion must not invalidate cached proofs.
scripts/pipeline/lib/factoryCore.mjs -text
scripts/pipeline/lib/factoryEvidence.mjs -text
scripts/pipeline/lib/evidencePipeline.mjs -text
scripts/pipeline/lib/focusedCoverage.mjs -text
scripts/pipeline/lib/focusedSources.mjs -text
scripts/pipeline/lib/compactBenchmark.mjs -text
data/content_evidence.js -text
data/question_factory_policy.mjs -text
data/question_factory_criteria.mjs -text
data/question_presentation.mjs -text
data/canonical_json.mjs -text

# Migrations and undo scripts are applied byte for byte and proved by md5(prosrc) after the apply: keep LF on every checkout
# (core.autocrlf=true used to hand Windows checkouts CRLF, so a function body hashed differently from the committed blob).
supabase/**/*.sql text eol=lf
# Key cards decks are checked against data/keycards/manifest.json by sha256 of their bytes; newline conversion would
# switch a subject off on a Windows checkout.
data/keycards/decks/*.json -text
data/keycards/links/*.json -text
data/keycards/manifest.json -text
