    "fresh-v73-cbse24-eco-q02-excerpt-1": {
      "id": "fresh-v73-cbse24-eco-q02-excerpt-1",
      "kind": "reference",
      "state": "active",
      "version": 1,
      "chapters": [
        "Government Budget & the Economy"
      ],
      "url": "https://ncert.nic.in/textbook/pdf/leec105.pdf",
      "title": "Selected authoritative teaching excerpt",
      "identity_sha256": "2fdd11fd2063ee4d35e065773686b74714a0d9ef636a54d4440326df82146149",
      "extraction_sha256": "ab64cbcf61be09c18329014ae6973524e59a9098f7877be05e937f8b566f56ac",
      "extraction_checked": true,
      "reuse_permitted": true,
      "permission": {
        "basis": "Brief attributed official NCERT excerpts for local educational verification; no unrestricted republication claim",
        "reference": "https://ncert.nic.in/textbook/pdf/leec105.pdf"
      },
      "facts": {
        "decisive-excerpt": {
          "text": "The government sector affects the personal disposable income of households by making transfers and collecting taxes. It is through this that the government can change the distribution of income and bring about a distribution that is considered ‘fair’ by society. This is the redistribution function"
