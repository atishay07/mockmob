        "reference": "https://ncert.nic.in/textbook/pdf/lebs106.pdf"
      },
      "facts": {
        "decisive-excerpt": {
          "text": "Competitive Spirit: If a company taps external sources, the extisting staff will have to compete with the outsiders. They will work harder to show better performance."
        }
      },
