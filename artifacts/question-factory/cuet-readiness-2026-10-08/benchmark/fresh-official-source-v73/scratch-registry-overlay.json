      "reuse_permitted": true,
      "permission": {
        "basis": "Brief attributed official NCERT excerpts for local educational verification; no unrestricted republication claim",
        "reference": "https://ncert.nic.in/textbook/pdf/lebs106.pdf"
      },
      "facts": {
        "decisive-excerpt": {
          "text": "Dissatisfaction among existing staff: Exter nal recruitment may lead to dissatisfaction and frustration among existing employees. They may feel that their chances of promotion are reduced."
        }
      },
      "supports": {
        "decisive-excerpt": "91bd640f467062d75ffd5664887c03d5503c9e7d6bffba9e5fa48a6f14b30497"
