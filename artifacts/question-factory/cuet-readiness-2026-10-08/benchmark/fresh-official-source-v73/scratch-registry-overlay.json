      "extraction_sha256": "4d606a56417cb8ca49dd9fcd18f03bdf2452a619b05f946c402559d5c40cbc7d",
      "extraction_checked": true,
      "reuse_permitted": true,
      "permission": {
        "basis": "Brief attributed official NCERT excerpts for local educational verification; no unrestricted republication claim",
        "reference": "https://ncert.nic.in/textbook/pdf/leec104.pdf"
      },
      "facts": {
        "decisive-excerpt": {
          "text": "Here C is the consumption expenditure by households. This consists of two components autonomous consumption and induced consumption ( cY ). Autonomous consumption is denoted by C and shows the consumption which is independent of income. If consumption takes place even when income is zero, it is because of autonomous consumption. The induced component of consumption, cY shows the dependence of consumption on income."
        }
      },
      "supports": {
        "decisive-excerpt": "a475500c249d10846ddb42d1d0e6d4db57d38b0e4dc0499becb57104e7160489"
      },
