diff --git a/scripts/pipeline/tests/factoryProfileV73.test.mjs b/scripts/pipeline/tests/factoryProfileV73.test.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/pipeline/tests/factoryProfileV73.test.mjs
@@ -0,0 +1,45 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createFactoryProfileV73, assertFactoryProfileV73, pinNewJobsToFactoryProfileV73 } from '../lib/factoryProfileV73.mjs';
+import { expectedReleaseBindingV73 } from '../lib/releaseEvidenceV73.mjs';
+import { RELEASE_POLICY_V7 } from '../lib/releaseEvidenceV7.mjs';
+import { evaluationCacheKeyV73 } from '../lib/contractV73.mjs';
+
+const registry={version:58};
+function fixture(){
+  const b=expectedReleaseBindingV73(),release={state:'released',topology:b.topology,problems:[],fresh_false_accepts:[],regression_false_accepts:[],
+    valid_survival:.9,valid_by_subject:Object.fromEntries(['accountancy','business_studies','economics','english'].map(s=>[s,{ok:9,n:10}])),
+    release_policy:RELEASE_POLICY_V7,critical_false_accepts:0,verifier_version:b.verifier_version,prompt_hash:b.prompt_hash,
+    cuet_fit_contract:b.cuet_fit_contract,effort_policy:b.effort_policy,efforts:b.efforts,validation_contract_hash:b.validation_contract_hash,
+    source_registry_version:registry.version,benchmark:{state:'completed',payload_hash:'a'.repeat(64)}};
+  return {manifest:{cuet_fit_releases:{[b.topology]:release}}};
+}
+
+test('profile binds current verifier, contract, sources and release',()=>{
+  const {manifest}=fixture(),profile=createFactoryProfileV73({campaignId:'prospective-73',manifest,registry});
+  assert.equal(assertFactoryProfileV73(profile,{manifest,registry}),profile);
+  assert.throws(()=>createFactoryProfileV73({campaignId:'prospective-73',manifest:{},registry}),/v73_current_release_required/);
+  assert.throws(()=>assertFactoryProfileV73({...profile,unknown:true},{manifest,registry}),/unknown_or_missing_field/);
+  assert.throws(()=>assertFactoryProfileV73({...profile,validation_contract_hash:'0'.repeat(64)},{manifest,registry}),/profile_hash_mismatch/);
+  assert.throws(()=>assertFactoryProfileV73(profile,{manifest,registry:{version:59}}),/current_release_mismatch/);
+});
+
+test('pinning affects only new jobs and refuses an existing pin',()=>{
+  const {manifest}=fixture(),profile=createFactoryProfileV73({campaignId:'prospective-73',manifest,registry});
+  const jobs=[{id:'new-job',subject:'english',generation_brief:null}],pinned=pinNewJobsToFactoryProfileV73(jobs,profile);
+  assert.equal(jobs[0].generation_brief,null);
+  assert.notEqual(pinned[0].generation_brief.validation_profile,profile);
+  assert.equal(pinned[0].generation_brief.validation_profile.profile_sha256,profile.profile_sha256);
+  assert.throws(()=>pinNewJobsToFactoryProfileV73([{...pinned[0],id:'second'}],profile),/already_pinned/);
+});
+
+test('student evidence rejects unknown v7 validator versions while preserving known releases',async()=>{
+  const { v73RuntimeEvidenceCurrent } = await import('../../../data/v73_runtime_evidence.mjs');
+  assert.equal(v73RuntimeEvidenceCurrent({verifier_version:'cuet-fit-validator-v7.4'},{manifest:{},registry}),false);
+  assert.equal(v73RuntimeEvidenceCurrent({verifier_version:'cuet-fit-validator-v7.2'},{manifest:{},registry}),true);
+});
+
+test('evaluation cache identity separates contract versions',()=>{
+  const input={candidate_id:'x'},base={input,provider:'openai',model:'gpt-6-luna',effort:'high',output:7500,promptHash:'p',policyVersion:'cuet-llm-v3'};
+  assert.notEqual(evaluationCacheKeyV73({...base,contractHash:'a'.repeat(64)}),evaluationCacheKeyV73({...base,contractHash:'b'.repeat(64)}));
+});
