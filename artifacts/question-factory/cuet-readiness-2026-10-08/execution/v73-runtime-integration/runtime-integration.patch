--- /dev/null
+++ b/scripts/pipeline/lib/factoryProfileV73.mjs
@@ -0,0 +1,42 @@
+import { hashJSON } from '../../../data/question_factory_policy.mjs';
+import { canonicalJSON } from '../../../data/canonical_json.mjs';
+import { expectedReleaseBindingV73 } from './releaseEvidenceV73.mjs';
+import { currentCuetCalibrationReadyVNext } from './currentCuetCalibrationGateVNext.mjs';
+
+export const FACTORY_PROFILE_V73 = 'factory-validation-profile-v1';
+const profileKeys = binding => ['profile_version','campaign_id',...Object.keys(binding),'source_registry_version','source_registry_sha256','release_sha256','profile_sha256'].sort();
+const sha = value => hashJSON(canonicalJSON(value));
+const base = ({campaignId, binding, registry, release}) => ({profile_version:FACTORY_PROFILE_V73,campaign_id:campaignId,
+  ...binding,source_registry_version:registry.version,source_registry_sha256:sha(registry),release_sha256:sha(release)});
+const validCampaignId = id => typeof id==='string' && /^[a-z0-9][a-z0-9-]{2,79}$/i.test(id);
+
+export function createFactoryProfileV73({campaignId,manifest,registry}) {
+  const binding=expectedReleaseBindingV73(),release=manifest?.cuet_fit_releases?.[binding.topology];
+  if(!validCampaignId(campaignId))throw Error('factory_campaign_id_required');
+  if(!currentCuetCalibrationReadyVNext({manifest,registry,binding}))throw Error('v73_current_release_required');
+  const value=base({campaignId,binding,registry,release});
+  return {...value,profile_sha256:sha(value)};
+}
+
+export function assertFactoryProfileV73(profile,{manifest,registry}) {
+  const binding=expectedReleaseBindingV73();
+  if(!profile || typeof profile!=='object' || Array.isArray(profile))throw Error('factory_validation_profile_required');
+  if(profile.profile_version!==FACTORY_PROFILE_V73)throw Error('factory_validation_profile_unknown_version');
+  if(Object.keys(profile).sort().join('|')!==profileKeys(binding).join('|'))throw Error('factory_validation_profile_unknown_or_missing_field');
+  if(!validCampaignId(profile.campaign_id))throw Error('factory_campaign_id_required');
+  const release=manifest?.cuet_fit_releases?.[binding.topology];
+  const value=base({campaignId:profile.campaign_id,binding,registry,release});
+  if(profile.profile_sha256!==sha(value))throw Error('factory_validation_profile_hash_mismatch');
+  for(const [key,expected] of Object.entries(binding))if(canonicalJSON(profile[key])!==canonicalJSON(expected))throw Error(`factory_validation_profile_binding_mismatch:${key}`);
+  if(profile.source_registry_version!==registry?.version || profile.source_registry_sha256!==sha(registry) || profile.release_sha256!==sha(release))throw Error('factory_validation_profile_current_release_mismatch');
+  if(!currentCuetCalibrationReadyVNext({manifest,registry,binding}))throw Error('v73_current_release_required');
+  return profile;
+}
+
+export function pinNewJobsToFactoryProfileV73(jobs,profile) {
+  if(!Array.isArray(jobs) || jobs.some(j=>!j?.id || j.candidate || ['published','eligible','pilot_eligible'].includes(j.state)))throw Error('factory_profile_new_jobs_only');
+  return jobs.map(job=>{
+    if(job.generation_brief?.validation_profile)throw Error('factory_validation_profile_already_pinned');
+    return {...job,generation_brief:{...(job.generation_brief||{}),validation_profile:structuredClone(profile)}};
+  });
+}
diff --git a/data/v73_runtime_evidence.mjs b/data/v73_runtime_evidence.mjs
new file mode 100644
--- /dev/null
+++ b/data/v73_runtime_evidence.mjs
@@ -0,0 +1,14 @@
+import { currentCuetCalibrationReadyVNext } from '../scripts/pipeline/lib/currentCuetCalibrationGateVNext.mjs';
+import { expectedReleaseBindingV73 } from '../scripts/pipeline/lib/releaseEvidenceV73.mjs';
+
+const V73='cuet-fit-validator-v7.3';
+export function v73RuntimeEvidenceCurrent(record,{manifest,registry}) {
+  const known=new Set(['cuet-fit-validator-v7.1','cuet-fit-validator-v7.2',V73]);
+  if(typeof record?.verifier_version==='string' && record.verifier_version.startsWith('cuet-fit-validator-v7.') && !known.has(record.verifier_version))return false;
+  if(record?.verifier_version!==V73)return true;
+  const binding=expectedReleaseBindingV73(),release=manifest?.cuet_fit_releases?.[binding.topology];
+  return Boolean(record.validation_contract_hash===binding.validation_contract_hash &&
+    release?.validation_contract_hash===record.validation_contract_hash &&
+    currentCuetCalibrationReadyVNext({manifest,registry,binding}));
+}
+
