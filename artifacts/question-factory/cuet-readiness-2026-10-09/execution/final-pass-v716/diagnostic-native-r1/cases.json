      "candidate": {
        "id": "f-234e398c6040b350",
        "subject": "accountancy",
        "chapter": "Cash Flow Statement",
        "concept_id": "accountancy:noncash-financing-investing-exclusion",
        "body": "A company acquires machinery by issuing its own equity shares directly to the seller; no cash or cash equivalent changes hands. How should this transaction be treated in the cash flow statement?",
        "options": [
          {
            "key": "A",
            "text": "Exclude it from the cash flow statement and disclose it elsewhere in the financial statements."
          },
          {
            "key": "B",
            "text": "Record a cash investing outflow and an equal operating inflow."
          },
          {
            "key": "C",
            "text": "Record a financing cash inflow because shares were issued, even though no cash was received."
          },
          {
            "key": "D",
            "text": "Treat the machinery as a cash equivalent."
          }
        ],
        "correct_answer": "A",
        "explanation": "Investing and financing transactions that do not use cash or cash equivalents are excluded from the cash flow statement and disclosed elsewhere.",
        "route": "conceptual",
        "difficulty": "medium",
        "question_type": "conceptual_mcq",
        "passage_text": null,
        "family_id": "fam-4578af8d21f01777",
