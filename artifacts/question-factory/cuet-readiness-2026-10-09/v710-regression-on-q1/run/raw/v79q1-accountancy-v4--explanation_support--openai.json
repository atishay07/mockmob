      "text": "{\n  \"candidate_id\": \"v710-v710-regression-on-q1-run-v79q1-accountancy-v4\",\n  \"content_hash\": \"3265c4f308603d74741872d0c80524d6573cc784170f6d5b52a5cb0d933765ea\",\n  \"claims\": [\n    {\n      \"claim\": \"The excerpt values goodwill by multiplying past average profits by the agreed number of years.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"The average profit is (Rs 30,000 + Rs 36,000 + Rs 42,000) / 3 = Rs 36,000.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Goodwill is Rs 36,000 × 4 = Rs 1,44,000.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Rs 36,000 omits the multiplier.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Rs 1,08,000 is the total of the three years’ profits.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Rs 4,32,000 multiplies that total by 4 instead of multiplying the average by 4.\",\n      \"basis\": \"arithmetic\"\n    }\n  ],\n  \"passed\": true,\n  \"reasons\": [\n    \"The excerpt supplies the average-profits formula; the stem gives the three profits and four years’ purchase. The calculations support A and reject B, C, and D.\"\n  ],\n  \"evidence_ids\": [\n    \"E1.1\"\n  ],\n  \"resolution_audit\": {\n    \"key\": \"A\",\n    \"key_fully_supported\": true,\n    \"key_reason\": \"The average is Rs 36,000; the excerpt’s method and the stem’s four years’ purchase give goodwill of Rs 1,44,000.\",\n    \"unexcluded_rival_conditions\": [],\n    \"distractors\": [\n      {\n        \"option\": \"B\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs 36,000 is the average; multiplying it by four gives Rs 1,44,000.\"\n      },\n      {\n        \"option\": \"C\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs 1,08,000 is the sum of the profits; the required four-year multiple of the average is Rs 1,44,000.\"\n      },\n      {\n        \"option\": \"D\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs 4,32,000 is four times the sum; goodwill uses four times the average, Rs 1,44,000.\"\n      }\n    ]\n  }\n}"
