      "text": "{\n  \"candidate_id\": \"v710-v710b-regression-on-q1-run-v79q1-accountancy-v4\",\n  \"content_hash\": \"3265c4f308603d74741872d0c80524d6573cc784170f6d5b52a5cb0d933765ea\",\n  \"claims\": [\n    {\n      \"claim\": \"The excerpt says goodwill is calculated by multiplying past average profits by the agreed number of years.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"The average profit is (30,000 + 36,000 + 42,000) / 3 = Rs 36,000.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Goodwill is Rs 36,000 × 4 = Rs 1,44,000.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Option B, Rs 36,000, omits the four-year multiplier.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Option C, Rs 1,08,000, is the total of the three years' profits.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Option D, Rs 4,32,000, results from multiplying that total by 4 instead of multiplying the average by 4.\",\n      \"basis\": \"arithmetic\"\n    }\n  ],\n  \"passed\": true,\n  \"reasons\": [],\n  \"evidence_ids\": [\n    \"E1.1\",\n    \"E1.2\"\n  ],\n  \"resolution_audit\": {\n    \"key\": \"A\",\n    \"key_fully_supported\": true,\n    \"key_reason\": \"The stem specifies four years' purchase of average profits; the average is Rs 36,000, and four times that is Rs 1,44,000.\",\n    \"unexcluded_rival_conditions\": [],\n    \"distractors\": [\n      {\n        \"option\": \"B\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs 36,000 is the average; multiplying it by the stated four years gives Rs 1,44,000.\"\n      },\n      {\n        \"option\": \"C\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs 1,08,000 is the sum of the profits, not four times their Rs 36,000 average.\"\n      },\n      {\n        \"option\": \"D\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Four times the Rs 36,000 average is Rs 1,44,000, not Rs 4,32,000.\"\n      }\n    ]\n  }\n}"
