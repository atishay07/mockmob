      "text": "{\n  \"candidate_id\": \"v710-v710b-regression-on-q1-run-v79q1-economics-v2\",\n  \"content_hash\": \"d7a4eb27b6819c403783e567e2ab095d60b2d7e1ce6f25c9ce9a10f1af9e6457\",\n  \"solved_key\": \"C\",\n  \"single_defensible_answer\": true,\n  \"source_support\": true,\n  \"numeric_solution\": true,\n  \"boundary_cases\": true,\n  \"passage_integrity\": true,\n  \"passage_answerability\": true,\n  \"meaningfully_distinct\": true,\n  \"evidence_ids\": [\n    \"E1.1\"\n  ],\n  \"reasons\": [\n    \"Reserves are 20% of deposits, so deposits supported = 300 ÷ 0.20 = Rs 1,500 crore.\",\n    \"E1.1 illustrates the same reserve-to-deposit relationship; no additional case-specific assumptions are needed.\"\n  ],\n  \"syllabus_chapter\": \"Money & Banking\",\n  \"syllabus_topic\": \"Money creation and reserve-ratio calculation of deposits supported by reserves\",\n  \"syllabus_entitlement\": true,\n  \"presentation_ready\": true,\n  \"question_type_match\": true,\n  \"principle_applicability\": \"excerpt_required\",\n  \"decisive_principle_in_excerpts\": true,\n  \"answer_conditions\": [\n    {\n      \"condition\": \"The reserve requirement is 20 per cent of deposits.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"The bank holds Rs 300 crore in reserves.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"Reserves equal the reserve ratio multiplied by deposits; therefore deposits supported equal reserves divided by the reserve ratio.\",\n      \"status\": \"convention\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": [\n        \"E1.1\"\n      ]\n    }\n  ],\n  \"option_challenges\": [\n    {\n      \"option\": \"A\",\n      \"strongest_reading\": \"Multiplying Rs 300 crore by 20% gives Rs 60 crore, but the stem makes reserves 20% 