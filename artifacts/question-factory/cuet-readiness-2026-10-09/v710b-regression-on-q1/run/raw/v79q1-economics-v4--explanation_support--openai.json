      "text": "{\n  \"candidate_id\": \"v710-v710b-regression-on-q1-run-v79q1-economics-v4\",\n  \"content_hash\": \"1f18f9fe4a50892df012444a5ec2d8bb9d00306e537a0630f42aa2ebfaf0408a\",\n  \"claims\": [\n    {\n      \"claim\": \"Revenue receipts do not lead to a claim on the government.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"Revenue receipts are therefore termed non-redeemable.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"Revenue receipts are divided into tax and non-tax revenues.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"Corporation tax is a tax revenue.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"The government never returns the corporation tax.\",\n      \"basis\": \"unsupported\"\n    },\n    {\n      \"claim\": \"The corporation tax receipt creates no claim on the government.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"The fact that the government never returns the corporation tax establishes that it creates no claim.\",\n      \"basis\": \"unsupported\"\n    },\n    {\n      \"claim\": \"The bond loan must be repaid on maturity.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"The foreign-government loan is to be repaid with interest.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"The securities in option D are redeemable after a fixed period.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"The repayment obligations in options B and C entail a claim on the government.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"The redeemability in option D entails a claim on the government.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"Options B, C and D are not revenue receipts.\",\n      \"basis\": \"excerpt\"\n    }\n  ],\n  \"passed\": false,\n  \"reasons\": [\n    \"The key is supported: the stem identifies corporation tax as a tax, and the excerpt includes tax revenues among revenue receipts, which do not lead to a claim.\",\n    \"The explanation overstates the stem by changing “never has to return” into “never returns”; absence of an obligation does not establish actual non-return.\",\n    \"The repayment and redemption terms in B–D conflict with the excerpt’s no-claim criterion, so rejecting those options is supported.\"\n  ],\n  \"evidence_ids\": [\n    \"E1.1\"\n  ],\n  \"resolution_audit\": {\n    \"key\": \"A\",\n    \"key_fully_supported\": true,\n    \"key_reason\": \"The stem identifies A as corporation tax and says it need not be returned; the excerpt includes tax revenues among revenue receipts and defines them as not leading to a claim.\",\n    \"unexcluded_rival_conditions\": [],\n    \"distractors\": [\n      {\n        \"option\": \"B\",\n        \"decisively_wrong\": true,\n        \"basis\": \"direct_contradiction\",\n        \"reason\": \"The stem requires repayment on maturity, which entails a claim and conflicts with the excerpt’s no-claim definition.\"\n      },\n      {\n        \"option\": \"C\",\n        \"decisively_wrong\": true,\n        \"basis\": \"direct_contradiction\",\n        \"reason\": \"The stem says the loan is to be repaid with interest; that repayment obligation entails a claim.\"\n      },\n      {\n        \"option\": \"D\",\n        \"decisively_wrong\": true,\n        \"basis\": \"direct_contradiction\",\n        \"reason\": \"The stem says the securities are redeemable, whereas the excerpt characterizes revenue receipts as non-redeemable.\"\n      }\n    ]\n  }\n}"
