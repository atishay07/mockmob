      "text": "{\n  \"candidate_id\": \"v712-v712-qualification-q3-run-v712q3-accountancy-d4\",\n  \"content_hash\": \"c9a43b459623546883df6118b312e122b33c136aa658c4451660850f693d1b07\",\n  \"solved_key\": \"B\",\n  \"single_defensible_answer\": true,\n  \"source_support\": true,\n  \"numeric_solution\": true,\n  \"boundary_cases\": true,\n  \"passage_integrity\": true,\n  \"passage_answerability\": true,\n  \"meaningfully_distinct\": true,\n  \"evidence_ids\": [\n    \"E1.1\"\n  ],\n  \"reasons\": [\n    \"The stem gives EPS = Rs. 12, market price = Rs. 96, and the formula; 96 ÷ 12 = 8, so B.\",\n    \"E1.1 confirms the P/E formula. No authenticated comparator was supplied; this original-practice item needs no PYQ counterpart.\"\n  ],\n  \"syllabus_chapter\": \"Accounting Ratios\",\n  \"syllabus_topic\": \"Price/Earnings ratio calculation\",\n  \"syllabus_entitlement\": true,\n  \"presentation_ready\": true,\n  \"question_type_match\": true,\n  \"principle_applicability\": \"excerpt_required\",\n  \"decisive_principle_in_excerpts\": true,\n  \"answer_conditions\": [\n    {\n      \"condition\": \"Earnings per share is Rs. 12.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"Market price per share is Rs. 96.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"P/E Ratio = Market Price of a share / Earnings per share.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    }\n  ],\n  \"option_challenges\": [\n    {\n      \"option\": \"A\",\n      \"strongest_reading\": \"A quotient of 6 would require different inputs, such as 96 ÷ 16; the stem specifies EPS of Rs. 12.\",\n      \"correct_under_reading\": false,\n      \"reading_status\": \"contradicts_stem\",\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"option\": \"C\",\n      \"strongest_reading\": \"Rs. 12 is the given EPS, but the stem asks for the ratio calculated using market price divided by EPS.\",\n      \"correct_under_reading\": false,\n      \"reading_status\": \"contradicts_stem\",\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"option\": \"D\",\n      \"strongest_reading\": \"Reversing the printed division gives 12 ÷ 96 = 0.125, but the stem specifies market price divided by EPS.\",\n      \"correct_under_reading\": false,\n      \"reading_status\": \"contradicts_stem\",\n      \"convention_evidence_ids\": []\n    }\n  ],\n  \"blocking_defects\": [],\n  \"style_notes\": [\n    \"The formula is printed, so the item tests substitution and division rather than formula recall.\"\n  ],\n  \"cuet_fit\": {\n    \"criteria\": {\n      \"syllabus_objective\": {\n        \"level\": 2,\n        \"evidence\": \"A standard application within the syllabus's Accounting Ratios unit.\"\n      },\n      \"format_authenticity\": {\n        \"level\": 2,\n        \"evidence\": \"Workable four-option objective numerical item; no matched authenticated comparator was supplied.\"\n      },\n      \"level_calibration\": {\n        \"level\": 3,\n        \"evidence\": \"One-step application of a supplied NCERT ratio formula; no matched comparator was supplied.\"\n      },\n      \"discrimination_value\": {\n        \"level\": 2,\n        \"evidence\": \"Distractors include the EPS itself and the reciprocal, as well as an incorrect quotient.\"\n      }\n    },\n    \"reasoning_steps\": 1,\n    \"estimated_difficulty\": \"easy\",\n    \"cognitive_level\": \"application\",\n    \"exemplar_ids_compared\": []\n  },\n  \"option_resolution\": [\n    {\n      \"option\": \"A\",\n      \"status\": \"contradicted\",\n      \"false_part\": \"6\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"The earnings per share of a company is Rs. 12 and the market price of its share is Rs. 96. Using P/E Ratio = Market Price of a share / Earnings per share\",\n      \"reason\": \"The stated inputs yield 96 ÷ 12 = 8, not 6.\"\n    },\n    {\n      \"option\": \"B\",\n      \"status\": \"supported\",\n      \"false_part\": \"\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"The earnings per share of a company is Rs. 12 and the market price of its share is Rs. 96. Using P/E Ratio = Market Price of a share / Earnings per share\",\n      \"reason\": \"The stated formula and inputs give 96 ÷ 12 = 8.\"\n    },\n    {\n      \"option\": \"C\",\n      \"status\": \"contradicted\",\n      \"false_part\": \"12\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"The earnings per share of a company is Rs. 12 and the market price of its share is Rs. 96. Using P/E Ratio = Market Price of a share / Earnings per share\",\n      \"reason\": \"12 is the input EPS; the requested quotient is 96 ÷ 12 = 8.\"\n    },\n    {\n      \"option\": \"D\",\n      \"status\": \"contradicted\",\n      \"false_part\": \"0.125\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"The earnings per share of a company is Rs. 12 and the market price of its share is Rs. 96. Using P/E Ratio = Market Price of a share / Earnings per share\",\n      \"reason\": \"0.125 is the reciprocal 12 ÷ 96; the specified calculation is 96 ÷ 12 = 8.\"\n    }\n  ]\n}"
