      "text": "{\n  \"candidate_id\": \"v712-v712-qualification-q3-run-v712q3-accountancy-v3\",\n  \"content_hash\": \"6878ddef4adceb5b482af67eb831d9cb1c69f2f207f601f56692282e0b2a47cb\",\n  \"claims\": [\n    {\n      \"claim\": \"B's new share is one-third of the remaining three-fourths, because A and B divide that share in their old 2:1 ratio.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"B's new share is therefore one-fourth.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"B's required capital is one-fourth of Rs. 80,000, or Rs. 20,000.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"B's capital after adjustments is Rs. 15,000.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"B's capital is Rs. 5,000 short of the required Rs. 20,000.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"B must bring in Rs. 5,000 to reach the required capital.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Withdrawing Rs. 5,000 would apply to a surplus.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"B does not have a surplus.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"Rs. 20,000 is the required capital, not the shortfall.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"No adjustment is needed is wrong.\",\n      \"basis\": \"arithmetic\"\n    },\n    {\n      \"claim\": \"B's Rs. 15,000 capital differs from the required Rs. 20,000.\",\n      \"basis\": \"arithmetic\"\n    }\n  ],\n  \"passed\": true,\n  \"reasons\": [\n    \"The stem gives B one-third of the remaining three-fourths and a total capital of Rs. 80,000; the required capital is Rs. 20,000.\",\n    \"B has Rs. 15,000, leaving a Rs. 5,000 deficiency. E2.1 supports bringing in an additional amount to reach the required capital.\"\n  ],\n  \"evidence_ids\": [\n    \"E1.1\",\n    \"E2.1\"\n  ],\n  \"resolution_audit\": {\n    \"key\": \"C\",\n    \"key_fully_supported\": true,\n    \"key_reason\": \"B's one-fourth share requires Rs. 20,000 of capital; the stated Rs. 15,000 leaves a Rs. 5,000 deficiency.\",\n    \"unexcluded_rival_conditions\": [],\n    \"distractors\": [\n      {\n        \"option\": \"A\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"B's required capital exceeds the stated capital by Rs. 5,000, so the adjustment is an addition, not a withdrawal.\"\n      },\n      {\n        \"option\": \"B\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs. 20,000 is B's required total capital; subtracting the stated Rs. 15,000 gives a Rs. 5,000 contribution.\"\n      },\n      {\n        \"option\": \"D\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"B's Rs. 15,000 capital is below the Rs. 20,000 required for his share.\"\n      }\n    ]\n  }\n}"
