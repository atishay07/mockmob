      "text": "{\n  \"candidate_id\": \"v712-v712-qualification-q3-run-v712q3-accountancy-v4\",\n  \"content_hash\": \"55894af5263e7824bbb7d9320e8a222185e981b83fff4d8c4876e8e080139772\",\n  \"solved_key\": \"D\",\n  \"single_defensible_answer\": true,\n  \"source_support\": true,\n  \"numeric_solution\": true,\n  \"boundary_cases\": true,\n  \"passage_integrity\": true,\n  \"passage_answerability\": true,\n  \"meaningfully_distinct\": true,\n  \"evidence_ids\": [\n    \"E1.1\"\n  ],\n  \"reasons\": [\n    \"Normal profit = Rs. 3,00,000 × 10% = Rs. 30,000; super profit = Rs. 45,000 − Rs. 30,000 = Rs. 15,000.\",\n    \"Goodwill = Rs. 15,000 × 100/10 = Rs. 1,50,000 (D). E1.1 supports the super-profit capitalisation formula.\"\n  ],\n  \"syllabus_chapter\": \"Goodwill Valuation\",\n  \"syllabus_topic\": \"Capitalisation of super profit: normal profit, super profit, and goodwill calculation\",\n  \"syllabus_entitlement\": true,\n  \"presentation_ready\": true,\n  \"question_type_match\": true,\n  \"principle_applicability\": \"excerpt_required\",\n  \"decisive_principle_in_excerpts\": true,\n  \"answer_conditions\": [\n    {\n      \"condition\": \"Capital employed is Rs. 3,00,000.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"Normal rate of return is 10%.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"Average profit is Rs. 45,000.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"The capitalisation of super profit method and its two formulas are specified in the stem.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    }\n  ],\n  \"option_challenges\": [\n    {\n      \"option\": \"A\",\n      \"strongest_reading\": \"Reporting super profit itself gives Rs. 15,000, but the stem’s stated goodwill formula capitalizes that amount.\",\n      \"correct_under_reading\": false,\n      \"reading_status\": \"contradicts_stem\",\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"option\": \"B\",\n      \"strongest_reading\": \"Capitalizing average profit instead would give Rs. 4,50,000, but the stem specifies goodwill from super profit.\",\n      \"correct_under_reading\": false,\n      \"reading_status\": \"contradicts_stem\",\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"option\": \"C\",\n      \"strongest_reading\": \"Rs. 30,000 is normal profit, not goodwill; the stem asks for goodwill using capitalized super profit.\",\n      \"correct_under_reading\": false,\n      \"reading_status\": \"contradicts_stem\",\n      \"convention_evidence_ids\": []\n    }\n  ],\n  \"blocking_defects\": [],\n  \"style_notes\": [\n    \"No authenticated comparator was supplied; original-practice items do not require one.\"\n  ],\n  \"cuet_fit\": {\n    \"criteria\": {\n      \"syllabus_objective\": {\n        \"level\": 3,\n        \"evidence\": \"Goodwill valuation methods, including super-profit and capitalisation methods, are named syllabus content.\"\n      },\n      \"format_authenticity\": {\n        \"level\": 2,\n        \"evidence\": \"A clear four-option, single-answer numerical MCQ; no authenticated comparator was supplied.\"\n      },\n      \"level_calibration\": {\n        \"level\": 3,\n        \"evidence\": \"Routine Class XII formula application with straightforward arithmetic; no authenticated comparator was supplied.\"\n      },\n      \"discrimination_value\": {\n        \"level\": 3,\n        \"evidence\": \"Distractors reflect confusing super profit, normal profit, or average profit with capitalised goodwill.\"\n      }\n    },\n    \"reasoning_steps\": 3,\n    \"estimated_difficulty\": \"easy\",\n    \"cognitive_level\": \"application\",\n    \"exemplar_ids_compared\": []\n  },\n  \"option_resolution\": [\n    {\n      \"option\": \"A\",\n      \"status\": \"contradicted\",\n      \"false_part\": \"Rs. 15,000\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"capital employed of Rs. 3,00,000 and the normal rate of return is 10%. Its average profit is Rs. 45,000.\",\n      \"reason\": \"Normal profit is Rs. 30,000; super profit is Rs. 15,000; capitalisation gives goodwill of Rs. 1,50,000.\"\n    },\n    {\n      \"option\": \"B\",\n      \"status\": \"contradicted\",\n      \"false_part\": \"Rs. 4,50,000\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"capital employed of Rs. 3,00,000 and the normal rate of return is 10%. Its average profit is Rs. 45,000.\",\n      \"reason\": \"The specified method capitalizes super profit, Rs. 15,000, not average profit; the result is Rs. 1,50,000.\"\n    },\n    {\n      \"option\": \"C\",\n      \"status\": \"contradicted\",\n      \"false_part\": \"Rs. 30,000\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"capital employed of Rs. 3,00,000 and the normal rate of return is 10%. Its average profit is Rs. 45,000.\",\n      \"reason\": \"Rs. 30,000 is normal profit; capitalised super profit gives goodwill of Rs. 1,50,000.\"\n    },\n    {\n      \"option\": \"D\",\n      \"status\": \"supported\",\n      \"false_part\": \"\",\n      \"premise_source\": \"arithmetic\",\n      \"evidence_id\": \"\",\n      \"premise_quote\": \"A firm has capital employed of Rs. 3,00,000 and the normal rate of return is 10%. Its average profit is Rs. 45,000. Using the capitalisation of super profit method, with Normal Profit = Capital Employed x Normal Rate/100 and Goodwill = Super Profit x 100/Normal Rate of Return, what is the value of goodwill?\",\n      \"reason\": \"Normal profit is Rs. 30,000; super profit is Rs. 15,000; goodwill is Rs. 15,000 × 100/10 = Rs. 1,50,000.\"\n    }\n  ]\n}"
