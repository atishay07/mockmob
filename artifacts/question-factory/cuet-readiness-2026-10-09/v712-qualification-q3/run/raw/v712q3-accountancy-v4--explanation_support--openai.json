cluded_rival_conditions\": [],\n    \"distractors\": [\n      {\n        \"option\": \"A\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs. 15,000 is the calculated super profit; applying the stated goodwill formula gives Rs. 1,50,000.\"\n      },\n      {\n        \"option\": \"B\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs. 4,50,000 is average profit multiplied by 100/10; the stated method capitalises Rs. 15,000 super profit.\"\n      },\n      {\n        \"option\": \"C\",\n        \"decisively_wrong\": true,\n        \"basis\": \"arithmetic\",\n        \"reason\": \"Rs. 30,000 is normal profit; applying the stated formula to super profit gives goodwill of Rs. 1,50,000.\"\n      }\n    ]\n  }\n}"
