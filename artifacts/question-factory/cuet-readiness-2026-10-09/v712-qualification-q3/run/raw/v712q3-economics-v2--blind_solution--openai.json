tion\":\"C\",\"status\":\"contradicted\",\"false_part\":\"Rs 200\",\"premise_source\":\"arithmetic\",\"evidence_id\":\"\",\"premise_quote\":\"At an output of 4 units, a firm has a total fixed cost of Rs 80 and a total variable cost of Rs 120.\",\"reason\":\"Total cost is 80 + 120 = 200; SAC is 200/4 = Rs 50.\"},{\"option\":\"D\",\"status\":\"contradicted\",\"false_part\":\"Rs 20\",\"premise_source\":\"arithmetic\",\"evidence_id\":\"\",\"premise_quote\":\"At an output of 4 units, a firm has a total fixed cost of Rs 80 and a total variable cost of Rs 120.\",\"reason\":\"AFC is 80/4 = 20 and AVC is 120/4 = 30; their sum is Rs 50, not Rs 20.\"}]}"
