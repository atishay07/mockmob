      "text": "{\"candidate_id\":\"v79q1-run-v79q1-accountancy-v4\",\"content_hash\":\"3265c4f308603d74741872d0c80524d6573cc784170f6d5b52a5cb0d933765ea\",\"claims\":[{\"claim\":\"The excerpt says goodwill is valued by multiplying past average profits by the agreed number of years’ purchase.\",\"basis\":\"excerpt\"},{\"claim\":\"The average profit is (30,000 + 36,000 + 42,000) / 3 = Rs 36,000.\",\"basis\":\"arithmetic\"},{\"claim\":\"Goodwill is Rs 36,000 × 4 = Rs 1,44,000.\",\"basis\":\"arithmetic\"},{\"claim\":\"Rs 36,000 omits the stated four-year multiplier.\",\"basis\":\"arithmetic\"},{\"claim\":\"Rs 1,08,000 is the total of the three years’ profits, not the goodwill value under the stated method.\",\"basis\":\"arithmetic\"},{\"claim\":\"Rs 4,32,000 results from multiplying the total profits by 4 instead of multiplying the average profit by 4.\",\"basis\":\"arithmetic\"}],\"passed\":true,\"reasons\":[\"The method is supported by E1.1, and the calculation and explanations for the three distractors are correct.\"],\"evidence_ids\":[\"E1.1\"],\"resolution_audit\":{\"key\":\"A\",\"key_fully_supported\":true,\"key_reason\":\"The stem gives the three profits and four years’ purchase; E1.1 supplies the method, yielding Rs 1,44,000.\",\"unexcluded_rival_conditions\":[],\"distractors\":[{\"option\":\"B\",\"decisively_wrong\":true,\"basis\":\"arithmetic\",\"reason\":\"Rs 36,000 is the average profit; the stated four years’ purchase gives Rs 1,44,000.\"},{\"option\":\"C\",\"decisively_wrong\":true,\"basis\":\"arithmetic\",\"reason\":\"Rs 1,08,000 is the three-year total; four years’ purchase of the average is Rs 1,44,000.\"},{\"option\":\"D\",\"decisively_wrong\":true,\"basis\":\"arithmetic\",\"reason\":\"Multiplying the average profit by four gives Rs 1,44,000, not Rs 4,32,000.\"}]}}"
