      "text": "{\n  \"candidate_id\": \"v79q1-run-v79q1-economics-v1\",\n  \"content_hash\": \"be1e4a86dc4750511e2fbc184ded1074f0ccaf67e6e80945ea15b0e5e4d06cc2\",\n  \"claims\": [\n    {\n      \"claim\": \"In a fixed exchange rate system, a government action that increases the exchange rate, making the domestic currency cheaper, is called devaluation.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"Here, the rate rises from Rs 75 to Rs 80 per dollar.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"Revaluation is when the government decreases the exchange rate.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"That decrease is the opposite direction from the change in the stem.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"Appreciation is defined for a flexible regime when the price of the rupee in dollars increases.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"Here, the rupee has become cheaper.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"The change in the stem is a government action.\",\n      \"basis\": \"stem\"\n    },\n    {\n      \"claim\": \"A floating rate is determined by market forces of demand and supply.\",\n      \"basis\": \"excerpt\"\n    },\n    {\n      \"claim\": \"The stem describes a government decision rather than the market-determined floating-rate condition.\",\n      \"basis\": \"excerpt\"\n    }\n  ],\n  \"passed\": true,\n  \"reasons\": [\n    \"The devaluation and revaluation descriptions match the fixed-rate definitions in E3.1 and the stated rate change.\",\n    \"The appreciation distinction matches E2.1; the floating-rate description and its contrast with the stated government action match E1.1 and the stem.\"\n  ],\n  \"evidence_ids\": [\n    \"E1.1\",\n    \"E2.1\",\n    \"E3.1\"\n  ],\n  \"resolution_audit\": {\n    \"key\": \"B\",\n    \"key_fully_supported\": true,\n    \"key_reason\": \"The stem states a fixed-rate government action that raises the exchange rate, which E3.1 identifies as devaluation.\",\n    \"unexcluded_rival_conditions\": [],\n    \"distractors\": [\n      {\n        \"option\": \"A\",\n        \"decisively_wrong\": true,\n        \"basis\": \"direct_contradiction\",\n        \"reason\": \"E3.1 defines revaluation as a government decrease in the exchange rate; the stem states an increase.\"\n      },\n      {\n        \"option\": \"C\",\n        \"decisively_wrong\": true,\n        \"basis\": \"direct_contradiction\",\n        \"reason\": \"E2.1 defines appreciation in a flexible regime; the stem specifies a fixed-rate government action.\"\n      },\n      {\n        \"option\": \"D\",\n        \"decisively_wrong\": true,\n        \"basis\": \"direct_contradiction\",\n        \"reason\": \"E1.1 describes floating rates as market-determined; the stem specifies a fixed rate changed by government action.\"\n      }\n    ]\n  }\n}"
