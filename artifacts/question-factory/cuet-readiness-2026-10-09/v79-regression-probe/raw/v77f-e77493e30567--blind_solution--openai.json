      "text": "{\n  \"candidate_id\": \"v79-regression-2026-10-09-v77f-e77493e30567\",\n  \"content_hash\": \"9a464dcfc46e300212b0fad5888d389a0ff2640332fe3395c01a535627750400\",\n  \"solved_key\": \"A\",\n  \"single_defensible_answer\": true,\n  \"source_support\": true,\n  \"numeric_solution\": true,\n  \"boundary_cases\": true,\n  \"passage_integrity\": true,\n  \"passage_answerability\": true,\n  \"meaningfully_distinct\": true,\n  \"evidence_ids\": [\n    \"E2.1\",\n    \"E3.1\"\n  ],\n  \"reasons\": [\n    \"E2.1 classifies cash receipts as inflows and payments to suppliers as outflows. Net cash is ₹12,000 − ₹4,500 = ₹7,500, option A.\",\n    \"E3.1 includes Cash Flow Statement preparation in the Analysis of Financial Statements syllabus.\"\n  ],\n  \"syllabus_chapter\": \"Cash Flow Statement\",\n  \"syllabus_topic\": \"Operating cash inflows and outflows; calculating net cash from stated receipts and payments.\",\n  \"syllabus_entitlement\": true,\n  \"presentation_ready\": true,\n  \"question_type_match\": true,\n  \"principle_applicability\": \"excerpt_required\",\n  \"decisive_principle_in_excerpts\": true,\n  \"answer_conditions\": [\n    {\n      \"condition\": \"Cash received from customers is ₹12,000.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"Cash paid to suppliers is ₹4,500.\",\n      \"status\": \"explicit\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": []\n    },\n    {\n      \"condition\": \"Treat the receipt as an inflow and the supplier payment as an outflow.\",\n      \"status\": \"convention\",\n      \"alters_key_if_changed\": true,\n      \"convention_evidence_ids\": [\n        \"E2.1\"\n      ]\n    }\n  ],\n  \"option_challenges\": [\n    {\n      \"option\": \"B\",\n      \"strongest_reading\": \"No reading consistent with the stated amounts gives ₹8,500: net cash is ₹12,000 less ₹4,500, or ₹7,500.\