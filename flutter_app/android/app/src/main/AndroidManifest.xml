<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Local reminders (spec 8, amendment A3: no push, no Firebase in v1). Inexact scheduling only,
         so SCHEDULE_EXACT_ALARM and USE_EXACT_ALARM are deliberately absent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keeps the screen on while a mock is running (wakelock_plus). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permissions audit (16 Oct 2026). androidx.biometric arrives as a dependency of a plugin and
         adds these two; the app never shows a biometric prompt, so they are removed from the merged
         manifest. Play then shows no biometric permission for the app. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (spec 4.3): https://www.mockmob.in only. The apex redirects and
                 verification does not follow redirects, so it is not listed. Verification needs
                 the Play App Signing SHA-256 on the server (ANDROID_CERT_SHA256); until then the
                 links open in the browser. Pricing and checkout paths are intentionally absent.

                 Links are read by app_links (router.dart) and run through ActionRouter, so Flutter's own
                 deep-link handling is turned off below (flutter_deeplinking_enabled false) to stop the
                 engine from handling the same intent a second time. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.mockmob.in" />
                <data android:pathPrefix="/today" />
                <data android:pathPrefix="/result" />
                <data android:pathPrefix="/review" />
                <data android:pathPrefix="/dashboard" />
                <data android:pathPrefix="/learn" />
                <!-- The signed-in website pages ActionRouter maps to a native screen (each has a
                     matching folder under src/app/(app)). -->
                <data android:pathPrefix="/test" />
                <data android:pathPrefix="/recovery" />
                <data android:pathPrefix="/progress" />
                <data android:pathPrefix="/study" />
                <data android:pathPrefix="/explore" />
                <data android:pathPrefix="/saved" />
                <data android:pathPrefix="/analytics" />
                <data android:pathPrefix="/join" />
                <data android:pathPrefix="/mob" />
            </intent-filter>

            <!-- Browser sign-in callback (docs/AUTH.md): in.mockmob.app://login-callback?code=...
                 It carries a one-time PKCE code, never a token; the code verifier stays in this
                 app's secure storage. AuthService acts only on this exact scheme and host. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="in.mockmob.app" android:host="login-callback" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget (plan A5): the next move, this week's study days and the days to
             CUET. Data comes from lib/core/home_widget through home_widget; a tap opens an
             https://www.mockmob.in link in MainActivity, handled like an App Link. -->
        <receiver
            android:name=".platform.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- The clock or the zone changed: the countdown and the "Updated" day are redrawn. -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- flutter_local_notifications (README, Android setup): the plugin's own manifest does not
             declare these. Without them a zonedSchedule alarm reaches no component, so no
             scheduled reminder is shown and none is re-armed after a reboot or an update, and the
             reminder action buttons (Start, Not tonight, Mute) do nothing. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- url_launcher: open https links, and use Custom Tabs when a browser offers them. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
