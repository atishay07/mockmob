<?xml version="1.0" encoding="utf-8"?>
<!-- The MockMob mark on the splash. Same geometry as the adaptive icon foreground, so it sits
     inside the circle Android 12 masks the splash icon to. Colour follows the day or night theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2">
        <path
            android:fillColor="@color/splash_mark"
            android:pathData="M13,2 L3,14 H12 L11,22 L21,10 H12 Z" />
    </group>
</vector>
