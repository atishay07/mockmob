<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: the raised surface with a 1 dp line, no gradient and no glow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_line" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
