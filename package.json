{
  "name": "mockmob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev --turbopack",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "nta:sample": "node --use-system-ca scripts/nta-sample.mjs",
    "nta:diagnose": "node --use-system-ca scripts/nta-diagnose.mjs",
    "test:nta": "node --test data/tests/nta_question_selector.test.mjs",
    "test:study": "node --test data/tests/study_engine.test.mjs data/tests/study_content.test.mjs data/tests/study_database.test.mjs",
    "test:answer-integrity": "node --test data/tests/answer_integrity.test.mjs",
    "db:seed": "node scripts/seed.mjs",
    "autonomous": "node --use-system-ca --env-file=.env.local scripts/pipeline/autonomous/worker.mjs --start",
    "validate:sample": "node --use-system-ca --env-file=.env.local scripts/pipeline/validate-existing.mjs --mode=sample --sample-size=50",
    "validate:dry-run": "node --use-system-ca --env-file=.env.local scripts/pipeline/validate-existing.mjs --mode=dry-run",
    "validate:apply": "node --use-system-ca --env-file=.env.local scripts/pipeline/validate-existing.mjs --mode=apply",
    "answer-integrity:dry-run": "node --use-system-ca --env-file=.env.local scripts/answer-integrity-cleanup.mjs --mode=dry-run --subjects=top15 --scope=visible",
    "answer-integrity:apply": "node --use-system-ca --env-file=.env.local scripts/answer-integrity-cleanup.mjs --mode=apply --subjects=top15 --scope=visible",
    "answer-integrity:semantic-dry-run": "node --use-system-ca --env-file=.env.local scripts/answer-integrity-semantic-sweep.mjs --mode=dry-run --subjects=top15 --scope=visible",
    "answer-integrity:semantic-apply": "node --use-system-ca --env-file=.env.local scripts/answer-integrity-semantic-sweep.mjs --mode=apply --subjects=top15 --scope=visible",
    "test:recovery": "node --test data/tests/recovery.test.mjs scripts/pipeline/tests/recoverySafety.test.mjs scripts/pipeline/tests/evidencePipeline.test.mjs scripts/pipeline/tests/sourceAdapters.test.mjs data/tests/recoveryDatabase.test.mjs data/tests/recovery_pathway_candidate.test.mjs data/tests/session_recovery.test.mjs",
    "audit:bank": "node --use-system-ca --env-file=.env.local scripts/pipeline/tools/auditBank.mjs --database",
    "recovery:validate": "node scripts/learning/validate-pathway.mjs sacrificing_gaining --check",
    "test:du": "node --test data/tests/du_eligibility.test.mjs data/tests/du_combos.test.mjs",
    "du:build": "python scripts/du-csas/parse_cutoffs.py data/du-csas-2026/source/cutoff-r1.pdf round-1 data/du-csas-2026/parsed/round-1.json && python scripts/du-csas/parse_cutoffs.py data/du-csas-2026/source/cutoff-r2.pdf round-2 data/du-csas-2026/parsed/round-2.json && python scripts/du-csas/parse_cutoffs.py data/du-csas-2026/source/minscore-r3.pdf round-3 data/du-csas-2026/parsed/round-3.json && python scripts/du-csas/parse_boi.py data/du-csas-2026/source/boi.txt data/du-csas-2026/parsed/boi.json data/du-csas-2026/source/boi.pdf && python scripts/du-csas/build_dataset.py",
    "test:learning": "node --test data/tests/learning_engine.test.mjs data/tests/learning_database.test.mjs data/tests/runtime_ai_database.test.mjs data/tests/rival_submission.test.mjs data/tests/practice_quote.test.mjs data/tests/prepos_wallet.test.mjs data/tests/monthly_billing.test.mjs data/tests/prepos_insights.test.mjs data/tests/compass_projection.test.mjs data/tests/prepos_reservations.test.mjs data/tests/prepos_model_reply.test.mjs data/tests/landing_content.test.mjs data/tests/mistake_repair.test.mjs data/tests/exam_integrity_review.test.mjs data/tests/runtime_ai_monthly_cap.test.mjs",
    "study:build": "node scripts/learning/build-study-content.mjs",
    "study:validate": "node scripts/learning/validate-study-content.mjs --write --strict",
    "study:coverage": "node scripts/learning/study-coverage.mjs",
    "study:prepare": "npm run study:build && npm run study:validate && npm run study:coverage && node scripts/learning/study-content-v2-import.mjs --artifact-dir=artifacts/study-suite/v3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.34.0",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4"
  }
}
