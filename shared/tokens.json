{
  "$description": "MockMob brand tokens, one source for the web and (later, app lane) the Dart theme. Copied from flutter_app/lib/core/theme (mm_colors.dart, mm_type.dart, tokens.dart, motion.dart), which is the brand source of truth. Colours are #RRGGBB or #RRGGBBAA (CSS order, alpha last). Edit here, then run: node shared/build-tokens.mjs",
  "version": 1,
  "color": {
    "brand": {
      "volt": "#D2F000",
      "voltInk": "#0B1000",
      "voltEdge": "#9DB400",
      "lamp": "#F2A93B"
    },
    "night": {
      "ground": "#12110E",
      "raised": "#1B1A16",
      "raised2": "#25231E",
      "sunken": "#0D0C0A",
      "line": "#312E27",
      "lineStrong": "#4A453B",
      "ink": "#F4F0E6",
      "ink2": "#BDB6A6",
      "ink3": "#A09989",
      "ink4": "#6A645A",
      "accentText": "#D2F000",
      "focusRing": "#D2F000",
      "badText": "#FFA396",
      "warnText": "#EDB75A",
      "goodText": "#C6E86E",
      "wrongSurface": "#2A1614",
      "wrongBorder": "#7D3128",
      "wrongText": "#FFC9C2",
      "scrim": "#08070599",
      "optionLip": "#0A0907",
      "voltGlow": "#D2F00024",
      "voltWash": "#D2F00014",
      "glassTint": "#1C1A169E",
      "glassTintLite": "#1C1A16E0",
      "edgeTop": "#FFF6E424",
      "edgeBottom": "#FFF6E408",
      "litTile": "#FFF6E41F",
      "hover": "#FFF6E40D"
    },
    "day": {
      "ground": "#F3EFE6",
      "raised": "#FFFDF8",
      "raised2": "#E9E4D8",
      "sunken": "#EAE5DA",
      "line": "#D8D1C2",
      "lineStrong": "#BDB4A2",
      "ink": "#17150F",
      "ink2": "#454036",
      "ink3": "#655F53",
      "ink4": "#8A8375",
      "accentText": "#526700",
      "focusRing": "#526700",
      "badText": "#B0291F",
      "warnText": "#845400",
      "goodText": "#3D6600",
      "wrongSurface": "#FBE9E7",
      "wrongBorder": "#B93225",
      "wrongText": "#B0291F",
      "scrim": "#17150F66",
      "optionLip": "#D8D1C2",
      "voltGlow": "#D2F00038",
      "voltWash": "#D2F0001F",
      "glassTint": "#FFFDF8B8",
      "glassTintLite": "#FFFDF8EB",
      "edgeTop": "#FFFFFFCC",
      "edgeBottom": "#2A20101F",
      "litTile": "#17150F12",
      "hover": "#17150F0A"
    }
  },
  "shadow": {
    "night": {
      "card": "0 1px 1px #00000040, 0 18px 36px -20px #00000059",
      "glass": "0 20px 40px -22px #00000080, 0 2px 6px -2px #00000033",
      "pop": "0 2px 6px -2px #00000040, 0 28px 56px -24px #00000099"
    },
    "day": {
      "card": "0 1px 2px #2A20100F, 0 14px 30px -18px #2A201026",
      "glass": "0 18px 36px -20px #2A20102E, 0 1px 3px #2A201014",
      "pop": "0 2px 6px -2px #2A20101A, 0 24px 48px -22px #2A201038"
    }
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "cssVar": "--font-bricolage", "axes": ["opsz", "wdth"], "fallback": "system-ui, sans-serif" },
    "body": { "family": "Hanken Grotesk", "cssVar": "--font-hanken", "fallback": "system-ui, sans-serif" }
  },
  "type": {
    "$note": "size and line are px at phone width (the app's sp). webMax grows display roles fluidly up to that px at 1280px wide. tracking is percent of the size. stretch is the Bricolage wdth axis (font-stretch).",
    "hero": { "font": "display", "size": 112, "line": 96, "weight": 700, "tracking": -1.5, "stretch": 75, "webMax": 144 },
    "figureHero": { "font": "display", "size": 96, "line": 86, "weight": 700, "tracking": -1, "stretch": 75, "webMax": 120 },
    "figure": { "font": "display", "size": 52, "line": 50, "weight": 700, "tracking": -1, "stretch": 75, "webMax": 64 },
    "figureCompact": { "font": "display", "size": 40, "line": 40, "weight": 700, "tracking": -0.5, "stretch": 75 },
    "moment": { "font": "display", "size": 36, "line": 38, "weight": 650, "tracking": -2.5, "stretch": 87, "webMax": 72 },
    "headline": { "font": "display", "size": 28, "line": 31, "weight": 650, "tracking": -2, "stretch": 87, "webMax": 44 },
    "screenTitle": { "font": "display", "size": 26, "line": 30, "weight": 600, "tracking": -1.5, "stretch": 100, "webMax": 34 },
    "title": { "font": "display", "size": 22, "line": 27, "weight": 600, "tracking": -1.5, "stretch": 100, "webMax": 26 },
    "timer": { "font": "display", "size": 20, "line": 22, "weight": 600, "tracking": 0, "stretch": 100 },
    "cardTitle": { "font": "body", "size": 17, "line": 22, "weight": 700, "tracking": -0.5 },
    "lead": { "font": "body", "size": 18, "line": 26, "weight": 400, "tracking": 0 },
    "question": { "font": "body", "size": 17, "line": 26, "weight": 500, "tracking": 0 },
    "body": { "font": "body", "size": 16, "line": 24, "weight": 400, "tracking": 0 },
    "button": { "font": "body", "size": 16, "line": 20, "weight": 600, "tracking": 0 },
    "labelLarge": { "font": "body", "size": 15, "line": 20, "weight": 600, "tracking": 0 },
    "small": { "font": "body", "size": 14, "line": 20, "weight": 400, "tracking": 0 },
    "label": { "font": "body", "size": 13, "line": 18, "weight": 600, "tracking": 0 },
    "caption": { "font": "body", "size": 13, "line": 18, "weight": 500, "tracking": 0 },
    "navLabel": { "font": "body", "size": 12, "line": 15, "weight": 600, "tracking": 0 }
  },
  "space": {
    "s2": 2, "s4": 4, "s6": 6, "s8": 8, "s12": 12, "s16": 16, "s20": 20, "s24": 24, "s32": 32, "s40": 40, "s48": 48, "s64": 64,
    "gutter": 16, "cardPadding": 20, "group": 32, "readMax": 600, "wrapMax": 1200
  },
  "radius": { "small": 12, "key": 18, "panel": 24, "sheet": 32, "pill": 999 },
  "target": { "min": 48, "primaryKey": 56, "option": 56, "chip": 40 },
  "motion": {
    "curve": {
      "glide": "cubic-bezier(0.15, 0.5, 0.5, 1)",
      "exit": "cubic-bezier(0.4, 0.3, 0.8, 0.6)",
      "emphasized": "cubic-bezier(0.16, 1, 0.3, 1)",
      "out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
      "inOut": "cubic-bezier(0.77, 0, 0.175, 1)",
      "sweep": "cubic-bezier(0.45, 0, 0.55, 1)"
    },
    "duration": {
      "press": 100, "release": 140, "ui": 200, "tabSwitch": 180, "card": 240, "ink": 260, "engrave": 280,
      "glide": 300, "result": 320, "emphasized": 420, "sheetIn": 420, "sheetOut": 240, "exit": 200,
      "crossFade": 200, "numberRoll": 500, "milestone": 500, "sweep": 700, "reducedFade": 120
    },
    "pressedScale": 0.96
  },
  "glass": { "blurChrome": 14, "blurSheet": 14, "blurControl": 12 },
  "dock": { "height": 60, "start": 60, "gap": 12, "lift": 10 }
}
